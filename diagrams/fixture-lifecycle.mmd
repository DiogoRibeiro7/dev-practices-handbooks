flowchart TB
    classDef stage fill:#E3F2FD,stroke:#0D47A1,stroke-width:1px;
    classDef guard fill:#FFF9C4,stroke:#F9A825,stroke-width:1px;

    provision[Provision fixture data]:::stage
    seed[Seed deterministic values]:::stage
    exercise[Exercise fixture in test]:::stage
    verify[Verify post-conditions]:::stage
    teardown[Teardown + cleanup]:::stage
    guard[Guard: idempotent resets & isolation]:::guard

    provision --> seed --> exercise --> verify --> teardown --> guard --> provision
