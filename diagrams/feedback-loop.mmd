flowchart LR
    classDef stage fill:#E3F2FD,stroke:#0D47A1,stroke-width:1px;
    classDef action fill:#C8E6C9,stroke:#2E7D32,stroke-width:1px;
    classDef guard fill:#FFF9C4,stroke:#F9A825,stroke-width:1px;

    dev[Developer works locally]:::stage
    change{Change approved?}:::guard
    localTest[Run suite locally]:::action
    ci[CI: lint + unit + integration]:::action
    staging[Staging smoke + monitoring]:::stage
    monitoring[Telemetry & incidents]:::guard
    feedback[Feedback to developer]:::guard

    dev --> localTest --> change
    change -- no --> dev
    change -- yes --> ci --> staging --> feedback --> dev
    staging --> monitoring --> dev
